            "name": "samples",
            "type": "CSV",
            "unit": "V"
          },
          {
            "name": "xorigin",
            "type": "NR3",
            "unit": "s"
          },
          {
            "name": "xincrement",
            "type": "NR3",
            "unit": "s"
          }
        ]
