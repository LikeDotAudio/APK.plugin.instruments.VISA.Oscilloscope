    "waveform_1": {
      "scpi": ":WAVeform:SOURce CHANnel1;:WAVeform:FORMat ASCii;:WAVeform:POINts 1000;:WAVeform:DATA?;:WAVeform:XORigin?;:WAVeform:XINCrement?",
      "scpiFast": ":WAV:SOUR CHAN1;:WAV:FORM ASC;:WAV:POIN 1000;:WAV:DATA?;:WAV:XOR?;:WAV:XINC?",
      "description": "Channel 1's trace, with the time axis it was captured on.",
      "subsystem": "WAVeform",
      "returns": {
        "count": 3,
        "separator": ";",
        "fields": [
          {
            "name": "samples",
            "type": "CSV",
            "unit": "V"
          },
          {
            "name": "xorigin",
            "type": "NR3",
            "unit": "s"
          },
          {
            "name": "xincrement",
            "type": "NR3",
            "unit": "s"
          }
        ]
      },
      "notes": "Samples ALONE cannot be plotted — the time axis rides in the same reply, because fetching it separately lets the two disagree when the timebase moves between reads. The source and format writes lead the queries in ONE message so the reply is the trace that was asked for. Authored 2026-08-08 for the tabbed oscilloscope panel; not yet executed against hardware.",
      "unverified": true
    },
    "waveform_2": {
      "scpi": ":WAVeform:SOURce CHANnel2;:WAVeform:FORMat ASCii;:WAVeform:POINts 1000;:WAVeform:DATA?;:WAVeform:XORigin?;:WAVeform:XINCrement?",
      "scpiFast": ":WAV:SOUR CHAN2;:WAV:FORM ASC;:WAV:POIN 1000;:WAV:DATA?;:WAV:XOR?;:WAV:XINC?",
      "description": "Channel 2's trace, with the time axis it was captured on.",
      "subsystem": "WAVeform",
      "returns": {
        "count": 3,
        "separator": ";",
