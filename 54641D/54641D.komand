    "trigger_settings": {
      "scpi": ":TRIGger:MODE?;:TRIGger:EDGE:LEVel?;:TRIGger:EDGE:SOURce?",
      "scpiFast": ":TRIG:MODE?;:TRIG:EDGE:LEV?;:TRIG:EDGE:SOUR?",
      "description": "Trigger type, edge level and edge source, in one round trip.",
      "subsystem": "TRIGger",
      "returns": {
        "count": 3,
        "separator": ";",
        "fields": [
          {
            "name": "mode",
            "type": "CRD"
          },
          {
            "name": "level",
            "type": "NR3",
            "unit": "V"
          },
          {
            "name": "source",
            "type": "CRD"
          }
        ]
      },
      "notes": "Verified on the 54641D at gpib7,6, 2026-08-08: the three answer as `EDGE;+0.0E+00;CHAN1`, and setting CHAN2 reads back CHAN2. Each statement is absolute (leading colon) because a chained query resolves against the CURRENT path, not the root."
    },
