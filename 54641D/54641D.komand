  "rig": {
    "Setup_Trigger_Edge": {
      "scpi": ":TRIGger:EDGE:SOURce <source>;:TRIGger:EDGE:SLOPe <slope>;:TRIGger:EDGE:LEVel <level>",
      "scpiFast": ":TRIG:EDGE:SOUR <source>;:TRIG:EDGE:SLOP <slope>;:TRIG:EDGE:LEV <level>",
      "description": "Set edge trigger source, slope and level together",
      "arg": {
        "kind": "enum"
      },
      "group": "Edge Trigger Config",
